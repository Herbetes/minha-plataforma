rules_version = '2';

// Armazenamento de arquivos: imagens de enunciado, uploads de CSV, anexos de resposta.
// Scoped por orgId, limite de tamanho e MIME por path.

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function daOrg(orgId) {
      return autenticado() && request.auth.token.orgId == orgId;
    }

    function papelEmOrg(orgId, papeis) {
      return daOrg(orgId) && request.auth.token.role in papeis;
    }

    function imagem() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    function pdf() {
      return request.resource.contentType == 'application/pdf'
          && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    function csv() {
      return (request.resource.contentType == 'text/csv'
              || request.resource.contentType == 'application/vnd.ms-excel')
          && request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    // Branding da org (logo, favicon)
    match /orgs/{orgId}/branding/{arquivo=**} {
      allow read: if daOrg(orgId);
      allow write: if papelEmOrg(orgId, ['admin']) && imagem();
    }

    // Imagens de questão
    match /orgs/{orgId}/questoes/{questaoId}/{arquivo=**} {
      allow read: if daOrg(orgId);
      allow write: if papelEmOrg(orgId, ['coordenador', 'admin']) && imagem();
    }

    // Uploads de CSV para importação de questões
    match /orgs/{orgId}/importacoes/{arquivo=**} {
      allow read, write: if papelEmOrg(orgId, ['coordenador', 'admin']) && csv();
    }

    // Anexos de resposta dissertativa (PDF/imagem). Aluno só escreve no próprio path.
    match /orgs/{orgId}/respostas/{alunoId}/{arquivo=**} {
      allow read: if daOrg(orgId) && (
        request.auth.uid == alunoId ||
        papelEmOrg(orgId, ['corretor', 'professor', 'coordenador', 'admin'])
      );
      allow write: if daOrg(orgId) && request.auth.uid == alunoId && (imagem() || pdf());
    }

    // Bundle de exportação LGPD (gerado por Cloud Function)
    match /orgs/{orgId}/exportacoes/{uid}/{arquivo=**} {
      allow read: if daOrg(orgId) && request.auth.uid == uid;
      allow write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
