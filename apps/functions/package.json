{
  "name": "functions",
  "version": "0.0.1",
  "private": true,
  "description": "Cloud Functions v2 (Node 20) da plataforma",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": { "node": "20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@minha-plataforma/feature-flags": "workspace:*",
    "@minha-plataforma/shared": "workspace:*",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
