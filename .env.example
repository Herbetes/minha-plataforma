# Frontend (apps/web) - prefixo VITE_ é exposto no bundle. NÃO coloque chaves de API de LLM aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_SENTRY_DSN=
VITE_USE_EMULATORS=true

# Cloud Functions (apps/functions) - SEM prefixo. São lidos via process.env e populados via Secret Manager em produção.
# Use `firebase functions:secrets:set NOME_DO_SEGREDO` em prod. Não commitar valores reais.
LLM_PROVIDER_PADRAO=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SENTRY_DSN_BACKEND=

# Billing / mensageria (fase posterior)
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
RESEND_API_KEY=
WHATSAPP_PROVIDER=zapi
ZAPI_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
