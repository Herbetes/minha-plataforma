# Copie para .env.local e preencha. NUNCA comite o .env.local.

# --- Anthropic (console.anthropic.com) ---
# Fica SÓ no servidor. Se aparecer no navegador, foi vazada.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: troque o modelo sem mexer no código.
ANTHROPIC_MODEL=claude-opus-5

# --- Supabase (supabase.com -> Project Settings -> API) ---
# A anon key é pública por design: o que protege os dados é o RLS do schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Radar (Projeto 3 — automação agendada) ---
# Chave de SERVIÇO do Supabase (Project Settings -> API -> service_role / secret).
# Ignora o RLS e enxerga a base inteira. Nunca use no navegador e NUNCA
# coloque prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Senha que autoriza o agendamento a rodar. Invente uma longa e aleatória.
CRON_SECRET=troque-por-algo-longo-e-aleatorio
# Envio de e-mail (resend.com -> API Keys).
RESEND_API_KEY=re_...
# Remetente. Só funciona com domínio verificado no Resend.
RADAR_REMETENTE=Radar VH <radar@seudominio.com.br>
